# OXA Broker configuration
# Copy this file to .env and fill in real values. NEVER commit real secrets:
# .env is gitignored at the repo root.

# ---------------------------------------------------------------------------
# Core RPC/network config
# ---------------------------------------------------------------------------

# Starknet RPC endpoint used by the broker's account (REQUIRED).
# Sepolia endpoint, e.g. from Alchemy / Infura / Blast.
RPC_URL=https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/YOUR_API_KEY_HERE

# ---------------------------------------------------------------------------
# Broker identity (the broker's own Starknet account — used for signing
# pool transactions, NOT for policy checks)
# ---------------------------------------------------------------------------

# Broker account address on Starknet Sepolia (REQUIRED).
BROKER_ACCOUNT_ADDRESS=0x0YOUR_BROKER_ACCOUNT_ADDRESS_HERE

# Broker account private key (REQUIRED).
BROKER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ---------------------------------------------------------------------------
# Owner identity (the account whose on-chain spend policies the broker
# checks against — DECISION 0001: Broker and Owner are distinct accounts;
# policy rows in OxaPolicyRegistry are keyed by the Owner's address)
# ---------------------------------------------------------------------------

# Owner account address on Starknet Sepolia (REQUIRED).
OWNER_ADDRESS=0xYOUR_OWNER_ADDRESS_HERE

# Owner account private key (OPTIONAL for now — not read by current code,
# but reserved for future setup-automation: Phase 4 contract deployment /
# authorization scripts will use it via the CLI's own keystore, not via
# this env var directly today).
OWNER_PRIVATE_KEY=0xYOUR_OWNER_PRIVATE_KEY_HERE

# ---------------------------------------------------------------------------
# Endpoint identity (the inference relay's own signing account — used by
# mcp-server.mjs when an MCP caller invokes oxa_call_endpoint; distinct
# from both Broker and Owner — DECISION 0005)
# ---------------------------------------------------------------------------

# Endpoint account address on Starknet Sepolia (REQUIRED for MCP oxa_call_endpoint).
ENDPOINT_ACCOUNT_ADDRESS=0xYOUR_ENDPOINT_ACCOUNT_ADDRESS_HERE

# Endpoint account private key (REQUIRED for MCP oxa_call_endpoint).
ENDPOINT_PRIVATE_KEY=0xYOUR_ENDPOINT_PRIVATE_KEY_HERE

# Destination address for redeemed credential payouts (REQUIRED for MCP
# oxa_call_endpoint unless overridden per-call in claimPayload).
ENDPOINT_PAYOUT_ADDRESS=0xYOUR_ENDPOINT_PAYOUT_ADDRESS_HERE

# ---------------------------------------------------------------------------
# Deployed contract addresses (REQUIRED)
# ---------------------------------------------------------------------------

# STRK20 privacy pool contract address on Sepolia.
PRIVACY_POOL_ADDRESS=0xYOUR_PRIVACY_POOL_ADDRESS_HERE

# OxaPolicyRegistry contract address on Sepolia.
POLICY_REGISTRY_ADDRESS=0xYOUR_POLICY_REGISTRY_ADDRESS_HERE

# OxaCredentialIssuer contract address on Sepolia.
CREDENTIAL_ISSUER_ADDRESS=0xYOUR_CREDENTIAL_ISSUER_ADDRESS_HERE

# ---------------------------------------------------------------------------
# Viewing key (REQUIRED) — shared with the privacy pool to read note balances
# for the Broker account. Generate with: node scripts/generate-canonical-viewing-key.mjs
# ---------------------------------------------------------------------------

VIEWING_KEY=0xYOUR_VIEWING_KEY_HERE

# ---------------------------------------------------------------------------
# Service URLs (see notes for required vs optional)
# ---------------------------------------------------------------------------

# STRK20 proving service base URL (REQUIRED for any pool operation - register,
# shield, mint, redeem, reclaim). Points at a self-hosted prover built from
# sequencer tag matching the target network's Starknet OS version
# (see .github/workflows/build-prover.yml).
PROVING_SERVICE_URL=

# Note indexer base URL for note discovery (OPTIONAL — if empty, the broker
# uses ContractDiscoveryProvider which queries the pool contract directly via RPC.)
INDEXER_URL=

# Base URL of the OXA Broker HTTP API (OPTIONAL — defaults to
# http://localhost:3000). Read by mcp-server.mjs to call /reclaim-expired.
BROKER_BASE_URL=http://localhost:3000

# Base URL of the inference relay service (OPTIONAL — if unset, MCP returns
# the on-chain redemption result without forwarding to a relay.)
INFERENCE_RELAY_URL=

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------

# HTTP port the broker server listens on (REQUIRED).
PORT=3000

# HTTP port the inference relay listens on (OPTIONAL — defaults to 3001;
# read by scripts/inference-relay.mjs.)
RELAY_PORT=3001

# HTTP port the MCP server listens on (OPTIONAL — defaults to 3002;
# read by scripts/mcp-server.mjs. Must not collide with PORT or RELAY_PORT.)
MCP_PORT=3002