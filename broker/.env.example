# OXA Broker configuration
# Copy this file to .env and fill in real values. NEVER commit real secrets:
# .env is gitignored at the repo root.

# Starknet RPC endpoint used by the broker's account
RPC_URL=

# Broker's Starknet account (the issuer of credentials)
BROKER_ACCOUNT_ADDRESS=
BROKER_PRIVATE_KEY=

# Viewing key for reading private transactions from the Privacy pool
VIEWING_KEY=

# Off-chain proving service base URL
PROVING_SERVICE_URL=

# Note indexer base URL for note discovery
INDEXER_URL=

# On-chain contract addresses
PRIVACY_POOL_ADDRESS=
POLICY_REGISTRY_ADDRESS=
CREDENTIAL_ISSUER_ADDRESS=

# HTTP port the broker listens on
PORT=3000
